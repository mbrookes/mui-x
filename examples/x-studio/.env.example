# x-studio environment configuration
# Copy this file to .env.local and fill in your values.

# ── Dev server connection ──────────────────────────────────────────────────────
# AI chat and dashboard-state persistence are routed through x-studio-dev-server.
# Start the dev server: cd examples/x-studio-dev-server && pnpm dev
STUDIO_SERVER_URL=http://localhost:3020

# ── Security ───────────────────────────────────────────────────────────────────
# Secret used to sign dev JWTs. Change this to a random string in production.
JWT_SECRET=dev-secret-change-in-production

# Optional: token for authenticated server setups
# STUDIO_SERVER_TOKEN=

# ── GitHub library-usage API server (src/server/index.ts) ──────────────────────
# Personal access token used to query the GitHub code-search API (required —
# code search rejects unauthenticated requests). No scopes are needed for
# searching public repositories. Server-side only — deliberately NOT prefixed
# with VITE_, so it is never bundled into the client and exposed to the browser.
# Run the API server alongside the Vite dev server: pnpm server (defaults to
# port 3006; Vite proxies /api requests to it — see vite.config.ts).
GITHUB_SEARCH_TOKEN=

# Comma-separated CORS origins for the API server's /api routes. Only needed
# for origins other than the server's own — same-origin requests (including
# the co-hosted production client) are always allowed.
# ALLOWED_ORIGINS=http://localhost:3004
